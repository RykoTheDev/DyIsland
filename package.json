{
  "name": "dyisland",
  "productName": "DyIsland",
  "version": "2.0.0",
  "description": "DyIsland: a Material 3 Expressive dynamic island overlay for Windows",
  "author": {
    "name": "RykoTheDev"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "build:theme": "node node_modules/esbuild/bin/esbuild theme-src.js --bundle --minify --format=iife --global-name=DyColor --outfile=vendor/dycolor.js",
    "icons": "node scripts/make-icon.js",
    "pack": "electron-builder --win --dir --publish never",
    "dist": "electron-builder --win --publish never",
    "ping": "node ping.js",
    "test:ui": "electron test/ui-smoke.js && electron test/ui-settings.js && electron test/ui-matrix.js && node test/main-smoke.js",
    "test:main": "node test/main-smoke.js"
  },
  "build": {
    "appId": "com.dyisland.app",
    "productName": "DyIsland",
    "copyright": "Copyright (c) 2026 RykoTheDev",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!test/**",
      "!scripts/**",
      "!.github/**",
      "!dist/**",
      "!ping.js",
      "!media.log",
      "!build/icon.ico",
      "!**/*.md",
      "!theme-src.js",
      "!.gitattributes",
      "!.gitignore"
    ],
    "asar": true,
    "asarUnpack": [
      "*.ps1",
      "dns/*.ps1",
      "hook.js",
      "approve-hook.js",
      "agent-hook.js",
      "dyisland.js",
      "dyisland.cmd"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "DyIsland-${version}-win-${arch}.${ext}",
      "legalTrademarks": "DyIsland"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "DyIsland",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "DyIsland-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "RykoTheDev",
        "repo": "dyisland"
      }
    ]
  },
  "devDependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ical.js": "^2.2.1"
  }
}
